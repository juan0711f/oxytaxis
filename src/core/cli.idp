////////////////////////////////////////////////////////////////////////////////////
// Interfaz de linea de comandos (CLI, por sus siglas en inglés)
////////////////////////////////////////////////////////////////////////////////////

func real printHelp(){
    cout << "Uso: FreeFem++ code.edp -nSimulacion <num> [opciones]\n\n";
    cout << "Obligatorio:\n";
    cout << "  -nSimulacion <int>      Numero de simulacion. La carpeta sera results/Simulacion<num>.\n\n";
    cout << "Modo:\n";
    cout << "  -soloCrecimiento        Solo resuelve los estados con controles nulos; si no se usa, corre control optimo.\n\n";
    cout << "Salida:\n";
    cout << "  -c <texto>              Comentario para el resumen.\n\n";
    cout << "Visualizacion:\n";
    cout << "  -mostrarU               Muestra u en una ventana durante cada paso temporal.\n";
    cout << "  -mostrarSigma           Muestra sigma en otra ventana durante cada paso temporal.\n\n";
    cout << "Tiempo:\n";
    cout << "  -nIter <int>            Iteraciones temporales (def " << nIter << ").\n";
    cout << "  -T <real>               Tiempo total (def " << T << "); dt se calcula como T/nIter.\n";
    cout << "  -maxControlIter <int>   Iteraciones del algoritmo de control optimo; -1 conserva while(true).\n\n";
    cout << "Modelo:\n";
    cout << "  -mesh <path>            Malla a leer (def " << meshPath << ").\n";
    cout << "  -Du -alpha -beta -xhi -psi -DSigma -Aox -kox -Per -Sv -Sc <real>\n";
    cout << "  -pmax -b -sigmaGauss -cmax -CT <real>\n";
    cout << "  -k1 -k2 -k3 -k4 -l1 -l2 <real>\n\n";
    cout << "Optimizador:\n";
    cout << "  -alpha0Adam -beta1Adam -beta2Adam -epsilonAdam <real>\n";
    cout << "  -loadControls <path>    Arranca desde los controles de un Controles_FuncionalMinimo.txt\n";
    cout << "                          en vez del bang-bang inicial (continuar una corrida).\n";
    cout << "  -h, --h, --help         Muestra esta ayuda.\n";
    return 0.;
}

/*
    Función para validar parámetros ingresados por el usuario
*/
func real validateCLIParams(){
    if(nIter <= 0){ cout << "Error: nIter debe ser positivo.\n"; exit(1); }
    if(T <= 0){ cout << "Error: T debe ser positivo.\n"; exit(1); }
    if(alpha <= 0){ cout << "Error: alpha debe ser positivo.\n"; exit(1); }
    if(beta <= 0){ cout << "Error: beta debe ser positivo.\n"; exit(1); }
    if(kox <= 0){ cout << "Error: kox debe ser positivo.\n"; exit(1); }
    if(controlCMax <= 0){ cout << "Error: cmax debe ser positivo.\n"; exit(1); }
    if(CT < 0){ cout << "Error: CT no puede ser negativo.\n"; exit(1); }
    if(maxControlIterations < -1){ cout << "Error: maxControlIter debe ser -1 o mayor.\n"; exit(1); }
    if(loadControlsPath != "")
    {
        if(system("test -f " + loadControlsPath) != 0)
        {
            cout << "Error: -loadControls no encuentra el fichero '" << loadControlsPath << "'.\n";
            exit(1);
        }
    }
    return 0.;
}

func bool cli(){
    int argc = ARGV.n;
    for(int i=1; i<argc; i++){
        string arg = ARGV[i];
        if(arg.find(".edp") != -1){
            // FreeFem puede incluir el nombre del script dentro de ARGV.
            i = i;
        }
        else if(arg == "-nw" || arg == "-ne" || arg == "-wait" || arg == "-cd"){
            // Opciones propias de FreeFem que no pertenecen a la simulacion.
            i = i;
        }
        else if(arg == "-v" || arg == "-fglut" || arg == "-ffg" || arg == "-glut" || arg == "-f"){
            // Opciones propias de FreeFem que requieren el siguiente valor.
            if(i+1 < argc) i++;
        }
        else if(arg == "-h" || arg == "--h" || arg == "--help"){
            printHelp();
            return false;
        }
        else if(arg == "-soloCrecimiento"){
            onlyGrowth = true;
            registerChange("modo", "solo crecimiento");
        }
        else if(arg == "-mostrarU"){
            showU = true;
            registerChange("mostrarU", "activado");
        }
        else if(arg == "-mostrarSigma"){
            showSigma = true;
            registerChange("mostrarSigma", "activado");
        }
        else if(arg == "-nSimulacion"){
            if(i+1 >= argc){ cout << "Falta valor para -nSimulacion\n"; exit(1); }
            string value = ARGV[i+1];
            simulationNumber = atoi(value);
            fileName = "Simulacion"+simulationNumber;
            registerChange("nSimulacion", value);
            i++;
        }
        else if(arg == "-nombre"){
            cout << "Error: -nombre ya no se usa. Ingresa -nSimulacion <num>; la carpeta sera Simulacion<num>.\n";
            exit(1);
        }
        else if(arg == "-c"){
            if(i+1 >= argc){ cout << "Falta valor para -c\n"; exit(1); }
            commentText = ARGV[i+1];
            registerChange("comentario", commentText);
            i++;
        }
        else if(arg == "-mesh"){
            if(i+1 >= argc){ cout << "Falta valor para -mesh\n"; exit(1); }
            meshPath = ARGV[i+1];
            registerChange("mesh", meshPath);
            i++;
        }
        else if(arg == "-loadControls"){
            if(i+1 >= argc){ cout << "Falta valor para -loadControls\n"; exit(1); }
            loadControlsPath = ARGV[i+1];
            registerChange("loadControls", loadControlsPath);
            i++;
        }
        else if(arg == "-nIter"){
            if(i+1 >= argc){ cout << "Falta valor para -nIter\n"; exit(1); }
            string value = ARGV[i+1];
            nIter = atoi(value);
            registerParamChange("nIter", value);
            i++;
        }
        else if(arg == "-T"){
            if(i+1 >= argc){ cout << "Falta valor para -T\n"; exit(1); }
            string value = ARGV[i+1];
            T = atof(value);
            registerParamChange("T", value);
            i++;
        }
        else if(arg == "-maxControlIter"){
            if(i+1 >= argc){ cout << "Falta valor para -maxControlIter\n"; exit(1); }
            string value = ARGV[i+1];
            maxControlIterations = atoi(value);
            registerParamChange("maxControlIter", value);
            i++;
        }
        else if(arg == "-Du"){
            if(i+1 >= argc){ cout << "Falta valor para -Du\n"; exit(1); }
            string value = ARGV[i+1]; Du = atof(value); registerParamChange("Du", value); i++;
        }
        else if(arg == "-alpha"){
            if(i+1 >= argc){ cout << "Falta valor para -alpha\n"; exit(1); }
            string value = ARGV[i+1]; alpha = atof(value); registerParamChange("alpha", value); i++;
        }
        else if(arg == "-beta"){
            if(i+1 >= argc){ cout << "Falta valor para -beta\n"; exit(1); }
            string value = ARGV[i+1]; beta = atof(value); registerParamChange("beta", value); i++;
        }
        else if(arg == "-xhi"){
            if(i+1 >= argc){ cout << "Falta valor para -xhi\n"; exit(1); }
            string value = ARGV[i+1]; xhi = atof(value); registerParamChange("xhi", value); i++;
        }
        else if(arg == "-psi"){
            if(i+1 >= argc){ cout << "Falta valor para -psi\n"; exit(1); }
            string value = ARGV[i+1]; psi = atof(value); registerParamChange("psi", value); i++;
        }
        else if(arg == "-DSigma"){
            if(i+1 >= argc){ cout << "Falta valor para -DSigma\n"; exit(1); }
            string value = ARGV[i+1]; DSigma = atof(value); registerParamChange("DSigma", value); i++;
        }
        else if(arg == "-Aox"){
            if(i+1 >= argc){ cout << "Falta valor para -Aox\n"; exit(1); }
            string value = ARGV[i+1]; Aox = atof(value); registerParamChange("Aox", value); i++;
        }
        else if(arg == "-kox"){
            if(i+1 >= argc){ cout << "Falta valor para -kox\n"; exit(1); }
            string value = ARGV[i+1]; kox = atof(value); registerParamChange("kox", value); i++;
        }
        else if(arg == "-Per"){
            if(i+1 >= argc){ cout << "Falta valor para -Per\n"; exit(1); }
            string value = ARGV[i+1]; Per = atof(value); registerParamChange("Per", value); i++;
        }
        else if(arg == "-Sv"){
            if(i+1 >= argc){ cout << "Falta valor para -Sv\n"; exit(1); }
            string value = ARGV[i+1]; Sv = atof(value); registerParamChange("Sv", value); i++;
        }
        else if(arg == "-Sc"){
            if(i+1 >= argc){ cout << "Falta valor para -Sc\n"; exit(1); }
            string value = ARGV[i+1]; Sc = atof(value); registerParamChange("Sc", value); i++;
        }
        else if(arg == "-pmax"){
            if(i+1 >= argc){ cout << "Falta valor para -pmax\n"; exit(1); }
            string value = ARGV[i+1]; pmax = atof(value); registerParamChange("pmax", value); i++;
        }
        else if(arg == "-b"){
            if(i+1 >= argc){ cout << "Falta valor para -b\n"; exit(1); }
            string value = ARGV[i+1]; b = atof(value); registerParamChange("b", value); i++;
        }
        else if(arg == "-sigmaGauss"){
            if(i+1 >= argc){ cout << "Falta valor para -sigmaGauss\n"; exit(1); }
            string value = ARGV[i+1]; gaussianSigmaRatio = atof(value); registerParamChange("sigmaGauss", value); i++;
        }
        else if(arg == "-cmax"){
            if(i+1 >= argc){ cout << "Falta valor para -cmax\n"; exit(1); }
            string value = ARGV[i+1]; controlCMax = atof(value); registerParamChange("cmax", value); i++;
        }
        else if(arg == "-CT" || arg == "-ct"){
            if(i+1 >= argc){ cout << "Falta valor para -CT\n"; exit(1); }
            string value = ARGV[i+1]; CT = atof(value); registerParamChange("CT", value); i++;
        }
        else if(arg == "-k1"){
            if(i+1 >= argc){ cout << "Falta valor para -k1\n"; exit(1); }
            string value = ARGV[i+1]; k1 = atof(value); registerParamChange("k1", value); i++;
        }
        else if(arg == "-k2"){
            if(i+1 >= argc){ cout << "Falta valor para -k2\n"; exit(1); }
            string value = ARGV[i+1]; k2 = atof(value); registerParamChange("k2", value); i++;
        }
        else if(arg == "-k3"){
            if(i+1 >= argc){ cout << "Falta valor para -k3\n"; exit(1); }
            string value = ARGV[i+1]; k3 = atof(value); registerParamChange("k3", value); i++;
        }
        else if(arg == "-k4"){
            if(i+1 >= argc){ cout << "Falta valor para -k4\n"; exit(1); }
            string value = ARGV[i+1]; k4 = atof(value); registerParamChange("k4", value); i++;
        }
        else if(arg == "-l1"){
            if(i+1 >= argc){ cout << "Falta valor para -l1\n"; exit(1); }
            string value = ARGV[i+1]; l1 = atof(value); registerParamChange("l1", value); i++;
        }
        else if(arg == "-l2"){
            if(i+1 >= argc){ cout << "Falta valor para -l2\n"; exit(1); }
            string value = ARGV[i+1]; l2 = atof(value); registerParamChange("l2", value); i++;
        }
        else if(arg == "-alpha0Adam"){
            if(i+1 >= argc){ cout << "Falta valor para -alpha0Adam\n"; exit(1); }
            string value = ARGV[i+1]; alpha0Adam = atof(value); registerParamChange("alpha0Adam", value); i++;
        }
        else if(arg == "-beta1Adam"){
            if(i+1 >= argc){ cout << "Falta valor para -beta1Adam\n"; exit(1); }
            string value = ARGV[i+1]; beta1Adam = atof(value); registerParamChange("beta1Adam", value); i++;
        }
        else if(arg == "-beta2Adam"){
            if(i+1 >= argc){ cout << "Falta valor para -beta2Adam\n"; exit(1); }
            string value = ARGV[i+1]; beta2Adam = atof(value); registerParamChange("beta2Adam", value); i++;
        }
        else if(arg == "-epsilonAdam"){
            if(i+1 >= argc){ cout << "Falta valor para -epsilonAdam\n"; exit(1); }
            string value = ARGV[i+1]; epsilonAdam = atof(value); registerParamChange("epsilonAdam", value); i++;
        }
        else {
            cout << "Argumento no reconocido: " << arg << "\n";
            cout << "Usa -h para ver las opciones disponibles.\n";
            exit(1);
        }
    }
    return true;
}

/*
    Valida que todo esté bien para continuar con la ejecución del código, especialmente, la existencia del número de simulación.
*/
func bool checkExecution(bool shouldValidate){
    if(!shouldValidate) return false;

    if(simulationNumber < 0){
        printHelp();
        cout << "\nFalta el parametro obligatorio -nSimulacion.\n";
        return false;
    }
    return true;
}
